#panes {
    height: 1fr;
}

.pane {
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
}

.pane:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

#issues-pane {
    width: 40;
}

#run-pane {
    width: 1fr;
}

#sessions-pane {
    width: 30;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

StepDetail {
    align: center middle;
}

#detail {
    width: 72;
    height: auto;
    border: round $accent;
    border-title-color: $accent;
    background: $surface;
    padding: 1 2;
}

#detail-hint {
    margin-top: 1;
    color: $text-muted;
}

#info {
    height: auto;
    padding: 0 1;
    border-bottom: solid $panel-lighten-2;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
