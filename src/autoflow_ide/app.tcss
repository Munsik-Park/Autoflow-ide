#panes {
    height: 1fr;
}

.pane {
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    border-subtitle-color: $text-muted;
}

.pane:focus-within {
    border: round $accent;
    border-title-color: $accent;
}

#issues-pane {
    width: 30;
}

#run-pane {
    width: 1fr;
}

/* The room under the info lines: rows past it scroll inside the table, which keeps the cursor's row in view (#69). */
#run {
    height: 1fr;
}

#sessions-pane {
    width: 28;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

StepDetail, OutputView {
    align: center middle;
}

#detail {
    width: 90%;
    max-width: 120;
    height: 90%;
    border: round $accent;
    border-title-color: $accent;
    background: $surface;
    padding: 0 1;
}

#detail-body {
    height: 1fr;
}

#detail-body > Markdown {
    margin: 0;
    padding: 0 1;
}

.detail-section {
    margin-top: 1;
    text-style: bold;
    color: $accent;
}

.detail-note {
    margin-top: 1;
    color: $text-muted;
}

#detail-hint {
    height: 1;
    color: $text-muted;
}

#info {
    height: auto;
    padding: 0 1;
    border-bottom: solid $panel-lighten-2;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#find {
    dock: bottom;
    border: tall $accent;
}
